# Server-side only. The browser uses /api; FastAPI remains the data boundary.
API_INTERNAL_URL=http://127.0.0.1:8000
# Local/Docker override only. On Vercel, HORIZON_API_URL is injected by the
# web -> api service binding. Do not create or set HORIZON_API_URL yourself.
# For protected deployments, match root/API settings:
# APP_ENV=production
# HORIZON_API_TOKEN=
# DASHBOARD_USER=horizon
# DASHBOARD_PASSWORD=
