# Shared server-side configuration. Never commit populated .env files.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=

ALPACA_NEWS_URL=wss://stream.data.alpaca.markets/v1beta1/news
ALPACA_DATA_URL=https://data.alpaca.markets/v2
ALPACA_PAPER_URL=https://paper-api.alpaca.markets/v2
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

APP_ENV=development
LOG_LEVEL=INFO
PAPER_TRADING_ENABLED=false
MAX_ORDER_NOTIONAL=100
MAX_EQUITY_FRACTION=0.01
MAX_OPEN_POSITIONS=5
MIN_SIGNAL_SCORE=60
MIN_PROFIT_PROBABILITY=0.60
MAX_SIGNAL_AGE_SECONDS=900
MAX_QUOTE_AGE_SECONDS=120
MIN_SHARE_PRICE=5
STOP_LOSS_FRACTION=0.05
TAKE_PROFIT_FRACTION=0.10
MAX_HOLDING_DAYS=5
QUANT_PATHS=10000
QUANT_HORIZON_DAYS=5
# QUANT_ENGINE_PATH=/absolute/path/to/horizon_quant

# Deployment only. Production refuses to start/serve without access protection.
# Use a random token of at least 32 characters and password of at least 16.
HORIZON_API_TOKEN=
DASHBOARD_USER=horizon
DASHBOARD_PASSWORD=
# For Docker with hosted Supabase, set the actual project URL here:
# SUPABASE_DOCKER_URL=https://your-project.supabase.co
